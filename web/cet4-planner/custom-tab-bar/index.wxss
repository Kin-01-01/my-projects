/* 自绘 tabBar · 浅色清爽系 */
.bar {
  display: flex;
  background: rgba(255, 255, 255, 0.94);
  -webkit-backdrop-filter: blur(20px);
  backdrop-filter: blur(20px);
  border-top: 1rpx solid rgba(22, 32, 58, 0.06);
  padding-bottom: env(safe-area-inset-bottom);
}
.item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 14rpx 0 10rpx;
  position: relative;
}
.item:active { opacity: 0.7; }
.tick {
  width: 44rpx;
  height: 4rpx;
  border-radius: 4rpx;
  background: transparent;
  margin-bottom: 8rpx;
  transition: width .3s cubic-bezier(.34, 1.56, .64, 1), background .3s ease;
}
.item-active .tick {
  width: 44rpx;
  background: linear-gradient(90deg, #5B8DEF, #36CFC9);
}
.txt {
  font-size: 22rpx;
  color: #9AA4B8;
  transition: color 0.2s ease;
}
.item-active .txt {
  color: #3B6EF6;
  font-weight: 600;
}
