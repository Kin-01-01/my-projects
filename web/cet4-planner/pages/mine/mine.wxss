.mine-head {
  display: flex; align-items: center; justify-content: space-between;
  padding: 24rpx 32rpx 4rpx;
}
.ix-burger { padding: 10rpx; }

/* 汉堡面板：展开/收起淡入 */
.burger-panel {
  margin: 4rpx 24rpx 0; padding: 8rpx 16rpx;
  background: #FFFFFF; border-radius: 20rpx;
  border: 1rpx solid rgba(22, 32, 58, 0.05);
  box-shadow: 0 4rpx 16rpx rgba(28, 46, 90, 0.06);
  animation: bp-in .28s ease;
}
@keyframes bp-in { from { opacity: 0; transform: translateY(-8rpx); } to { opacity: 1; transform: translateY(0); } }
.bp-item { padding: 20rpx 12rpx; font-size: 28rpx; color: #2C3858; border-bottom: 1rpx solid #F0F3F8; }
.bp-item:last-child { border-bottom: none; }
.bp-item.danger { color: #E5746B; }

.form-row { display: flex; align-items: center; margin-top: 22rpx; }
.form-label { width: 150rpx; color: #6E7891; font-size: 26rpx; flex-shrink: 0; }
.form-input { flex: 1; border-bottom: 1rpx solid #E2E8F2; padding: 8rpx 4rpx; font-size: 28rpx; color: #16203A; }
.form-picker { flex: 1; border-bottom: 1rpx solid #E2E8F2; padding: 8rpx 4rpx; font-size: 28rpx; color: #16203A; }

.tag {
  background: #EEF3FE; color: #3B6EF6;
  font-size: 22rpx; padding: 4rpx 16rpx; border-radius: 999rpx; flex-shrink: 0;
}
.del-link { color: #E5746B; font-size: 24rpx; padding: 6rpx 0 6rpx 16rpx; flex-shrink: 0; }

.pref-row { display: flex; align-items: center; }
.btn-wrap { position: relative; }
.btn-wrap .btn-primary, .btn-wrap .btn-ghost, .btn-wrap .btn-danger { margin-top: 20rpx; }
