<view class="page {{themeClass}}">
  <view class="wrap">
    <!-- 外观 -->
    <view class="block">
      <view class="block-title">外观</view>
      <view class="card">
        <view class="theme-list">
          <view
            class="theme-item {{themeSetting === 'light' ? 'theme-item-on' : ''}}"
            data-theme="light"
            bindtap="onChooseTheme"
            hover-class="row-hover"
          >
            <text class="theme-emoji">☀️</text>
            <text class="theme-label">白昼</text>
            <text class="theme-check">{{themeSetting === 'light' ? '✓' : ''}}</text>
          </view>
          <view
            class="theme-item {{themeSetting === 'dark' ? 'theme-item-on' : ''}}"
            data-theme="dark"
            bindtap="onChooseTheme"
            hover-class="row-hover"
          >
            <text class="theme-emoji">🌙</text>
            <text class="theme-label">深夜</text>
            <text class="theme-check">{{themeSetting === 'dark' ? '✓' : ''}}</text>
          </view>
          <view
            class="theme-item {{themeSetting === 'auto' ? 'theme-item-on' : ''}}"
            data-theme="auto"
            bindtap="onChooseTheme"
            hover-class="row-hover"
          >
            <text class="theme-emoji">🔄</text>
            <text class="theme-label">跟随系统</text>
            <text class="theme-check">{{themeSetting === 'auto' ? '✓' : ''}}</text>
          </view>
        </view>
        <view class="hint">选择「跟随系统」时，手机切换深色模式小程序会自动跟随。</view>
      </view>
    </view>

    <!-- 答题 -->
    <view class="block">
      <view class="block-title">答题</view>
      <view class="card">
        <view class="row">
          <view class="row-left">
            <text class="row-label">答对自动进入下一题</text>
            <text class="row-desc">答错不会自动跳，方便看解析</text>
          </view>
          <switch checked="{{autoNext}}" color="#B6E84E" bindchange="onToggleAutoNext" />
        </view>

        <view class="divider"></view>

        <view class="row-left">
          <text class="row-label">自动跳转延时</text>
          <text class="row-desc">{{delayDisabled ? '已关闭自动跳题，开启后才能设置' : '留出看解析的时间'}}</text>
        </view>
        <view class="delay-list">
          <view
            class="delay-item {{autoNextDelay === item.value ? 'delay-item-on' : ''}} {{delayDisabled ? 'delay-item-off' : ''}}"
            wx:for="{{delayOptions}}"
            wx:key="value"
            data-value="{{item.value}}"
            bindtap="onChooseDelay"
          >{{item.label}}</view>
        </view>
        <view class="hint">模拟考试模式强制不自动跳题。</view>
      </view>
    </view>

    <!-- 账号与云备份 -->
    <view class="block">
      <view class="block-title">账号与云备份</view>
      <view class="card">
        <view class="row" bindtap="onEditNickname" hover-class="row-hover">
          <view class="row-left">
            <text class="row-label">我的昵称</text>
            <text class="row-desc">{{nickname || '还没设置，点这里起个名字'}}</text>
          </view>
          <text class="row-arrow">›</text>
        </view>
        <view class="divider"></view>
        <view class="row" bindtap="onCloudBackup" hover-class="row-hover">
          <view class="row-left">
            <text class="row-label">立即备份到云端</text>
            <text class="row-desc">{{cloudReady ? '平时自动同步，这里可以手动补一次' : '云服务不可用，检查网络后再试'}}</text>
          </view>
          <text class="row-arrow">›</text>
        </view>
        <view class="divider"></view>
        <view class="row" bindtap="onCloudRestore" hover-class="row-hover">
          <view class="row-left">
            <text class="row-label">从云端恢复</text>
            <text class="row-desc">换手机、误删后，用云端数据覆盖本地</text>
          </view>
          <text class="row-arrow">›</text>
        </view>
        <block wx:if="{{hasSnapshot}}">
          <view class="divider"></view>
          <view class="row" bindtap="onRollbackSnapshot" hover-class="row-hover">
            <view class="row-left">
              <text class="row-label">回滚到覆盖前</text>
              <text class="row-desc">{{snapshotText}}</text>
            </view>
            <text class="row-arrow">›</text>
          </view>
        </block>
        <view class="hint">上次云端同步：{{lastSyncText}}</view>
      </view>
    </view>

    <!-- 数据 -->
    <view class="block">
      <view class="block-title">数据</view>
      <view class="card">
        <view class="row" bindtap="onBackup" hover-class="row-hover">
          <view class="row-left">
            <text class="row-label">备份全部数据</text>
            <text class="row-desc">打包所有题库与进度，复制到剪贴板</text>
          </view>
          <text class="row-arrow">›</text>
        </view>
        <view class="divider"></view>
        <view class="row" bindtap="onRestore" hover-class="row-hover">
          <view class="row-left">
            <text class="row-label">从备份恢复</text>
            <text class="row-desc">从剪贴板读取备份，会覆盖现有数据</text>
          </view>
          <text class="row-arrow">›</text>
        </view>
        <view class="divider"></view>
        <view class="row" bindtap="onClearAll" hover-class="row-hover">
          <view class="row-left">
            <text class="row-label row-label-danger">清空所有数据</text>
            <text class="row-desc">删除全部题库、进度、错题与收藏</text>
          </view>
          <text class="row-arrow">›</text>
        </view>
        <view class="hint">上次备份：{{lastBackupText}}</view>
      </view>
    </view>

    <!-- 关于 -->
    <view class="block">
      <view class="block-title">关于</view>
      <view class="card">
        <view class="about-row" bindtap="onTapVersion">
          <text class="about-label">版本</text>
          <text class="about-value">{{version}}</text>
        </view>
        <view class="about-row">
          <text class="about-label">题库数量</text>
          <text class="about-value">{{bankCount}} 个</text>
        </view>
        <view class="about-row">
          <text class="about-label">总题数</text>
          <text class="about-value">{{questionCount}} 道</text>
        </view>
        <view class="about-row">
          <text class="about-label">存储占用</text>
          <text class="about-value">{{usedText}} / {{limitText}}</text>
        </view>
        <view class="divider"></view>
        <view class="hint">数据默认存在本机，并自动备份到你的微信账号下。换手机、删掉小程序后重新进入，会自动恢复。</view>
      </view>
    </view>

    <view class="tab-space"></view>
  </view>
</view>
