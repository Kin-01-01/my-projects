/* pages/settings/settings.wxss —— 设置页 */

.wrap {
  padding-top: 24rpx;
}

.block {
  margin-top: 34rpx;
}

.block:first-child {
  margin-top: 0;
}

.block-title {
  font-size: 23rpx;
  font-weight: 700;
  color: var(--text-3);
  letter-spacing: 3rpx;
  padding: 0 12rpx 14rpx 12rpx;
}

/* ---------- 主题三选一 ---------- */
.theme-list {
  display: flex;
  align-items: stretch;
}

.theme-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 8rpx 20rpx 8rpx;
  border-radius: 26rpx;
  border: 2rpx solid var(--border);
  background: var(--card);
  margin-right: 16rpx;
  position: relative;
  transition: border-color 0.16s ease, background 0.16s ease;
}

.theme-item:last-child {
  margin-right: 0;
}

.theme-item-on {
  border-color: var(--ink);
  background: var(--lime-soft);
}

.theme-emoji {
  font-size: 40rpx;
  line-height: 1.2;
}

.theme-label {
  font-size: 23rpx;
  font-weight: 600;
  color: var(--text-2);
  margin-top: 10rpx;
}

.theme-item-on .theme-label {
  color: var(--text);
}

.theme-check {
  position: absolute;
  right: 12rpx;
  top: 10rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--text);
  height: 20rpx;
}

/* ---------- 行 ---------- */
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 6rpx 0;
}

.row-hover {
  opacity: 0.6;
}

.row-left {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding-right: 20rpx;
}

.row-label {
  font-size: 29rpx;
  font-weight: 600;
  color: var(--text);
}

.row-label-danger {
  color: var(--bad);
}

.row-desc {
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 6rpx;
  line-height: 1.5;
}

.row-arrow {
  font-size: 34rpx;
  color: var(--text-3);
  font-weight: 300;
}

/* ---------- 延时选择 ---------- */
.delay-list {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
}

.delay-item {
  flex: 1;
  height: 76rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 25rpx;
  font-weight: 600;
  color: var(--text-2);
  background: var(--bg-soft);
  margin-right: 14rpx;
}

.delay-item:last-child {
  margin-right: 0;
}

.delay-item-on {
  background: var(--ink);
  color: var(--on-ink);
}

.delay-item-off {
  opacity: 0.45;
}

/* ---------- 说明 ---------- */
.hint {
  font-size: 22rpx;
  color: var(--text-3);
  line-height: 1.7;
  margin-top: 20rpx;
}

/* ---------- 关于 ---------- */
.about-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
}

.about-label {
  font-size: 27rpx;
  color: var(--text-2);
}

.about-value {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--text);
}
