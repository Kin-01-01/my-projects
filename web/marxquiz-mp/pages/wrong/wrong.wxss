/* pages/wrong/wrong.wxss —— 错题本 / 收藏 */

/* ---------- 分段控件 ---------- */
.seg-wrap {
  padding: 24rpx 40rpx 4rpx 40rpx;
}

.seg {
  display: flex;
  align-items: center;
  padding: 8rpx;
  border-radius: 999rpx;
  background: var(--bg-soft);
}

.seg-item {
  flex: 1;
  height: 76rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 27rpx;
  font-weight: 600;
  color: var(--text-2);
  transition: background 0.16s ease, color 0.16s ease;
}

.seg-item-on {
  background: var(--card);
  color: var(--text);
  box-shadow: var(--shadow);
}

.seg-num {
  font-size: 22rpx;
  margin-left: 8rpx;
  color: var(--text-3);
}

.seg-item-on .seg-num {
  color: var(--text-2);
}

/* ---------- 分组 ---------- */
.group {
  margin-top: 30rpx;
}

.group-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 10rpx 16rpx 10rpx;
}

.group-head-left {
  display: flex;
  align-items: baseline;
  flex: 1;
  min-width: 0;
}

.group-name {
  font-size: 29rpx;
  font-weight: 700;
  color: var(--text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 380rpx;
}

.group-count {
  font-size: 21rpx;
  color: var(--text-3);
  margin-left: 14rpx;
}

.group-btn {
  height: 56rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  font-size: 23rpx;
  font-weight: 600;
  color: var(--text);
  background: var(--lime-soft);
  flex-shrink: 0;
}

.group-btn-hover {
  opacity: 0.7;
}

/* ---------- 题目项 ---------- */
.item {
  background: var(--card);
  border-radius: 30rpx;
  margin-bottom: 18rpx;
  box-shadow: var(--shadow), var(--inner);
  overflow: hidden;
}

.item-head {
  display: flex;
  align-items: flex-start;
  padding: 26rpx 26rpx 22rpx 26rpx;
}

.item-main {
  flex: 1;
}

.item-top {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.item-type {
  height: 40rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  display: inline-flex;
  align-items: center;
  font-size: 21rpx;
  font-weight: 600;
  color: var(--text-2);
  background: var(--bg-soft);
}

.item-badge {
  height: 40rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  display: inline-flex;
  align-items: center;
  font-size: 21rpx;
  font-weight: 600;
  color: var(--bad);
  background: var(--bad-soft);
  margin-left: 12rpx;
}

.item-stem {
  display: block;
  font-size: 28rpx;
  line-height: 1.64;
  color: var(--text);
}

.item-arrow {
  font-size: 19rpx;
  color: var(--text-3);
  margin-left: 14rpx;
  padding-top: 10rpx;
}

.item-body {
  padding: 0 26rpx 8rpx 26rpx;
}

.item-ans {
  display: flex;
  align-items: baseline;
  padding: 16rpx 22rpx;
  border-radius: 20rpx;
  background: var(--ok-soft);
  margin-bottom: 18rpx;
}

.item-ans-label {
  font-size: 22rpx;
  color: var(--text-2);
  margin-right: 12rpx;
}

.item-ans-value {
  font-size: 25rpx;
  font-weight: 700;
  color: var(--ok);
}

.item-analysis {
  padding: 24rpx;
  border-radius: 24rpx;
  background: var(--bg-soft);
}

.item-analysis-title {
  display: block;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--text-2);
  letter-spacing: 2rpx;
  margin-bottom: 12rpx;
}

.item-analysis-text {
  font-size: 25rpx;
  line-height: 1.86;
  color: var(--text-2);
}

.item-no-analysis {
  font-size: 24rpx;
  color: var(--text-3);
}

.item-foot {
  display: flex;
  justify-content: flex-end;
  padding: 18rpx 26rpx 22rpx 26rpx;
}

.item-remove {
  height: 56rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: var(--text-3);
  background: var(--bg-soft);
}

.item-remove-hover {
  opacity: 0.65;
}
