/* pages/index/index.wxss —— 首页 */

/* ---------- 顶部 ---------- */
.hero {
  position: relative;
  padding: 28rpx 40rpx 4rpx 40rpx;
  overflow: hidden;
}

.hero-blob {
  position: absolute;
  border-radius: 50%;
}

.hero-blob-a {
  width: 300rpx;
  height: 300rpx;
  right: -110rpx;
  top: -120rpx;
  background: var(--lime);
  opacity: 0.45;
}

.hero-blob-b {
  width: 170rpx;
  height: 170rpx;
  right: 70rpx;
  top: 96rpx;
  background: var(--mint);
  opacity: 0.35;
}

.hero-row {
  position: relative;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.hero-left {
  display: flex;
  flex-direction: column;
}

.hero-title {
  font-size: 54rpx;
  font-weight: 700;
  color: var(--text);
  letter-spacing: -1.4rpx;
  line-height: 1.24;
}

.hero-sub {
  font-size: 26rpx;
  color: var(--text-2);
  margin-top: 8rpx;
}

.icon-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  background: var(--card);
  border: 1rpx solid var(--border);
  box-shadow: var(--shadow), var(--inner);
  margin-top: 6rpx;
}

.icon-btn-hover {
  opacity: 0.7;
}

/* ---------- 概览统计 ---------- */
.stat-strip {
  position: relative;
  display: flex;
  align-items: center;
  margin-top: 34rpx;
  padding: 26rpx 8rpx;
  background: var(--card);
  border-radius: 30rpx;
  box-shadow: var(--shadow), var(--inner);
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text);
  letter-spacing: -0.6rpx;
  line-height: 1.2;
}

.stat-num-accent {
  color: var(--ok);
}

.stat-label {
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 6rpx;
  letter-spacing: 0.6rpx;
}

.stat-line {
  width: 1rpx;
  height: 44rpx;
  background: var(--border);
}

/* ---------- 题库卡片 ---------- */
.bank-list {
  padding-top: 26rpx;
}

.bank-card {
  position: relative;
  background: var(--card);
  border-radius: 34rpx;
  padding: 30rpx 30rpx 26rpx 30rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow), var(--inner);
  box-sizing: border-box;
}

.bank-card-hover {
  transform: scale(0.988);
  opacity: 0.94;
}

.bank-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.bank-name {
  flex: 1;
  font-size: 33rpx;
  font-weight: 700;
  color: var(--text);
  letter-spacing: -0.3rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding-right: 16rpx;
}

.bank-more {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-3);
  font-size: 32rpx;
  background: var(--bg-soft);
  flex-shrink: 0;
}

.bank-more-hover {
  opacity: 0.6;
}

.bank-meta {
  display: flex;
  align-items: baseline;
  margin-top: 14rpx;
}

.bank-count {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text);
}

.bank-unit {
  font-size: 23rpx;
  color: var(--text-2);
  margin-left: 4rpx;
}

.bank-dot {
  font-size: 22rpx;
  color: var(--text-3);
  margin: 0 12rpx;
}

.bank-meta-text {
  font-size: 24rpx;
  color: var(--text-2);
}

.bank-progress {
  height: 10rpx;
  border-radius: 999rpx;
  background: var(--bg-soft);
  margin: 20rpx 0 18rpx 0;
  overflow: hidden;
}

.bank-progress-in {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, var(--mint) 0%, var(--lime) 100%);
}

.bank-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.bank-time {
  font-size: 22rpx;
  color: var(--text-3);
}

.bank-wrong {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--bad);
  background: var(--bad-soft);
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}

/* ---------- 提示 ---------- */
.tips {
  padding: 18rpx 12rpx 0 12rpx;
  text-align: center;
}

.tips-text {
  font-size: 22rpx;
  color: var(--text-3);
}

/* ---------- 悬浮导入按钮 ---------- */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: calc(196rpx + env(safe-area-inset-bottom));
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 54rpx;
  font-weight: 300;
  color: var(--on-lime);
  background: linear-gradient(135deg, var(--lime) 0%, var(--lime-deep) 100%);
  box-shadow: var(--glow), var(--shadow-lg);
  z-index: 30;
}

.fab-hover {
  transform: scale(0.94);
  opacity: 0.92;
}
