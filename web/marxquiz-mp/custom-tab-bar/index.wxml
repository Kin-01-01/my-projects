<view class="tabbar {{themeClass}}">
  <view class="tabbar-inner">
    <view
      class="tab-item {{selected === index ? 'tab-item-on' : ''}}"
      wx:for="{{list}}"
      wx:key="path"
      data-index="{{index}}"
      bindtap="onTap"
    >
      <text class="tab-text">{{item.text}}</text>
    </view>
  </view>
</view>
